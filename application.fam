App(
    appid="radiogeddon",
    name="RadioGeddon",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="radiogeddon_app",
    stack_size=4 * 1024,
    fap_category="Sub-GHz",
    fap_author="Georgii",
    fap_version="1.0",
    fap_description="Standalone Sub-GHz radio analysis toolkit: scan, hop, record, decode, analyze, compare and replay signals on-device.",
    fap_icon="assets/icon_10px.png",
    fap_icon_assets="assets",
    # Each entry is matched recursively from the app root, so they must not
    # overlap (that would compile a file twice). The lone root file is named
    # explicitly and the host-only test/ directory is intentionally excluded.
    sources=[
        "radiogeddon.c",
        "scenes/*.c",
        "helpers/*.c",
        "views/*.c",
    ],
)
