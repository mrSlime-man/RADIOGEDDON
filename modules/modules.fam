    entry_point="radiogeddon_unknown_module_ep",
    requires=["radiogeddon_full"],
    cdefines=["RADIOGEDDON_EDITION_FULL"],
    sources=[
        "modules/radiogeddon_module_unknown.c",
        "helpers/radiogeddon_analysis_unknown.c",
        "helpers/radiogeddon_analysis_run.c",
        "helpers/rg_analyzer.c",
        "helpers/rg_checksum.c",
        "helpers/rg_raw.c",
        "helpers/radiogeddon_storage.c",
        "helpers/radiogeddon_dsp.c",
    ],
    fal_embedded=True,
