# Full edition modules (helpers/radiogeddon_modules.h): optional tools built as
# plugins, packed inside the .fap (fal_embedded) and loaded only while their
# screen is open. scripts/stage_edition.py appends this file to the Full
# edition's application.fam and takes these sources out of the app itself;
# the Catalog edition never builds them. A module uses the firmware's API
# only, so each lists every source it links (unused code is dropped).

App(
    appid="radiogeddon_bits",
    apptype=FlipperAppType.PLUGIN,
    entry_point="radiogeddon_bits_module_ep",
    requires=["radiogeddon_full"],
    cdefines=["RADIOGEDDON_EDITION_FULL"],
    sources=[
        "modules/radiogeddon_module_bits.c",
        "views/radiogeddon_bits_view.c",
        "helpers/rg_bits.c",
        "helpers/rg_glyph.c",
        "helpers/rg_analyzer.c",
    ],
    fal_embedded=True,
)

App(
    appid="radiogeddon_multi",
    apptype=FlipperAppType.PLUGIN,
    entry_point="radiogeddon_multi_module_ep",
    requires=["radiogeddon_full"],
    cdefines=["RADIOGEDDON_EDITION_FULL"],
    sources=[
        "modules/radiogeddon_module_multi.c",
        "helpers/radiogeddon_multi.c",
        "helpers/rg_multi.c",
        "helpers/rg_analyzer.c",
        "helpers/rg_raw.c",
        "helpers/radiogeddon_analysis_run.c",
        "helpers/radiogeddon_storage.c",
        "helpers/radiogeddon_dsp.c",
    ],
    fal_embedded=True,
)

App(
    appid="radiogeddon_wf",
