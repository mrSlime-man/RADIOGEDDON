App(
    appid="radiogeddon_sessions",
    apptype=FlipperAppType.PLUGIN,
    entry_point="radiogeddon_sessions_module_ep",
    requires=["radiogeddon_full"],
    cdefines=["RADIOGEDDON_EDITION_FULL", "RADIOGEDDON_MODULE"],
    sources=[
        "modules/radiogeddon_module_sessions.c",
        "scenes/radiogeddon_scene_sessions.c",
        "scenes/radiogeddon_scene_session_name.c",
        "scenes/radiogeddon_scene_session_menu.c",
        "scenes/radiogeddon_scene_session_signals.c",
        "scenes/radiogeddon_scene_session_groups.c",
        "helpers/radiogeddon_sessions.c",
        "helpers/rg_session.c",
        "helpers/radiogeddon_db.c",
        "helpers/rg_db.c",
        "helpers/radiogeddon_storage.c",
        "helpers/radiogeddon_dsp.c",
        "helpers/rg_raw.c",
        "helpers/rg_freq.c",
    ],
    fal_embedded=True,
)
